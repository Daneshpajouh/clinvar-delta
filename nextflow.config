manifest {
    name = 'Daneshpajouh/clinvar-variant-nf'
    author = 'Amir Daneshpajouh'
    homePage = 'https://github.com/Daneshpajouh/clinvar-variant-nf'
    description = 'Annotate germline VCFs with ClinVar and gnomAD, report a gene panel, and track ClinVar reclassifications'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.04.0'
    version = '1.0.0'
    license = 'Apache-2.0'
}

plugins {
    id 'nf-schema@2.8.0'
}

params {
    mode = 'annotate'
    input = null
    fasta = null
    clinvar = null
    gnomad = null
    panel = null
    prefilter_panel = true
    panel_padding = 1000
    min_stars = 1
    max_af = 0.01
    include_low_penetrance = true

    clinvar_old = null
    clinvar_new = null
    clinvar_old_label = 'old'
    clinvar_new_label = 'new'
    diff_genes = null

    outdir = 'results'
    publish_dir_mode = 'copy'

    // Slurm profile settings
    slurm_queue = null
    slurm_cluster_options = ''

    // Upper bounds applied to every request, including retries
    max_cpus = 8
    max_memory = '16.GB'
    max_time = '24.h'

    help = false
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    standard {
        process.executor = 'local'
        executor.cpus = 8
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        apptainer.enabled = false
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        docker.enabled = false
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    calibrated {
        includeConfig 'conf/calibrated.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
    test_diff {
        includeConfig 'conf/test_diff.config'
    }
}

// Always written, so every run can be profiled afterwards (docs/profiling.md).
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,cpus,memory,time,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,duration,submit,start,complete'
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
