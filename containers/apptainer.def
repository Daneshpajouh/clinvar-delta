Bootstrap: docker
From: python:3.13-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

%files
    pyproject.toml /opt/cvnf/pyproject.toml
    README.md /opt/cvnf/README.md
    src /opt/cvnf/src

%post
    apt-get update
    apt-get install -y --no-install-recommends procps
    rm -rf /var/lib/apt/lists/*
    pip install --no-cache-dir /opt/cvnf
    cvnf --version

%labels
    org.opencontainers.image.source https://github.com/Daneshpajouh/clinvar-variant-nf

%test
    cvnf --version
