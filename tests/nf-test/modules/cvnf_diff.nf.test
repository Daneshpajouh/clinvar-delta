nextflow_process {
    name "CVNF_DIFF"
    script "../../../modules/local/cvnf_diff/main.nf"
    process "CVNF_DIFF"

    test("classifies the hand-written releases") {
        when {
            process {
                """
                input[0] = ['old', file("${projectDir}/tests/data/mock/release_old.tsv"), 'new', file("${projectDir}/tests/data/mock/release_new.tsv")]
                input[1] = ['all', file("${projectDir}/assets/NO_GENES")]
                """
            }
        }
        then {
            assert process.success
            def stats = path(process.out.json[0][1]).json
            assert stats.changes == [added: 1, annotation_only: 1, reclassified: 1, removed: 1]
            assert snapshot(process.out.changes, process.out.json).match()
        }
    }
}
