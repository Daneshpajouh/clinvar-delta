// Bundled test data: two chr17 genes (BRCA1, TP53) and BRCA2 on chr13. Real HG002,
// ClinVar and gnomAD records from those windows plus one synthetic sample (see
// tests/data/README.md). Runs in under two minutes on a laptop.
params {
    input = "${projectDir}/tests/data/samplesheet.csv"
    fasta = "${projectDir}/tests/data/reference.fa.gz"
    clinvar = "${projectDir}/tests/data/clinvar_20261011.subset.vcf.gz"
    gnomad = "${projectDir}/tests/data/gnomad.subset.vcf.gz"
    panel = "${projectDir}/tests/data/panel.bed"
    max_cpus = 2
    max_memory = '4.GB'
    max_time = '1.h'
}
