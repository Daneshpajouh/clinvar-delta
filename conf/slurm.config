// Slurm: set --slurm_queue and, for accounts or QoS, --slurm_cluster_options.
// Label requests from conf/base.config apply; run with -profile slurm,calibrated to use
// the per-process requests measured on real data (docs/profiling.md).
process {
    executor = 'slurm'
    queue = params.slurm_queue
    clusterOptions = params.slurm_cluster_options
}

executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10 sec'
    pollInterval = '30 sec'
    queueStatInterval = '1 min'
}
