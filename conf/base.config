// Resource labels. Requests grow with task.attempt, and a retry happens only for the
// exit codes schedulers use for resource kills: 137 (SIGKILL, usually out of memory)
// and 140 (Slurm and SGE time limit). Other failures stop the run so they get read.
process {
    cpus = 1
    memory = { 2.GB * task.attempt }
    time = { 1.h * task.attempt }
    shell = ['/bin/bash', '-euo', 'pipefail']

    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'finish' }
    maxRetries = 2

    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]

    withLabel: 'process_single' {
        cpus = 1
        memory = { 1.GB * task.attempt }
        time = { 30.m * task.attempt }
    }
    withLabel: 'process_low' {
        cpus = 2
        memory = { 2.GB * task.attempt }
        time = { 1.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus = 4
        memory = { 4.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus = 8
        memory = { 16.GB * task.attempt }
        time = { 8.h * task.attempt }
    }

    withLabel: 'bcftools' {
        container = 'quay.io/biocontainers/bcftools:1.23.1--hb2cee57_0@sha256:8cf74dd0738e0a86fa3f8dc598596e8160e7e4e71380ab6db943a3b53f993869'
    }
    withLabel: 'cvnf' {
        container = 'ghcr.io/daneshpajouh/clinvar-delta:1.0.2'
    }
}
