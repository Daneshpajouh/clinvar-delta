params {
    mode = 'diff'
    clinvar_old = "${projectDir}/tests/data/clinvar_20251013.subset.vcf.gz"
    clinvar_new = "${projectDir}/tests/data/clinvar_20261011.subset.vcf.gz"
    clinvar_old_label = 'clinvar_20251013'
    clinvar_new_label = 'clinvar_20261011'
    diff_genes = "${projectDir}/tests/data/panel_genes.txt"
    max_cpus = 2
    max_memory = '4.GB'
    max_time = '1.h'
}
