process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename == 'versions.yml' ? null : filename },
    ]

    withName: 'CVNF_REPORT' {
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }
    withName: 'CVNF_DIFF_.*|CVNF_DIFF_REPORT' {
        publishDir = [
            path: { "${params.outdir}/clinvar_diff" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }
    withName: 'CVNF_MANIFEST|CVNF_OUTPUT_HASHES' {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: params.publish_dir_mode]
    }
    withName: 'CVNF_PANEL_PAD|TABIX_.*|CVNF_CLINVAR_TABLE|CLINVAR_QUERY_SORTED|BCFTOOLS_PREFILTER' {
        publishDir = [enabled: false]
    }
}
